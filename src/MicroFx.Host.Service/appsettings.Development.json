{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "MicroFx": {
    "Observability": {
      "SampleRatio": 1.0
    },
    "Health": {
      "IncludeExceptionDetail": true
    },
    "Persistence": {
      "CreateSchemaOnStartup": true,
      "OutboxPollInterval": "00:00:00.250"
    },
    "Jobs": {
      "TickInterval": "00:00:00.500"
    }
  }
}

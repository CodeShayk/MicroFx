<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Pins the whole transitive graph so a build today restores exactly what a build last month
         did. CI restores with locked mode, which fails rather than silently resolving a
         different version. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <UserSecretsId>microfx-host-service</UserSecretsId>
    <!-- Required for IDE0005 (unnecessary usings) to run as part of the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The host is an application, not a library; undocumented members are fine here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroFx\MicroFx.csproj" />
  </ItemGroup>

  <!-- The service supplies its own EF provider. The core references
       EntityFrameworkCore.Relational only, so changing engine needs no MicroFx package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MicroFx.Host.Service.E2E.Tests" />
  </ItemGroup>

</Project>
